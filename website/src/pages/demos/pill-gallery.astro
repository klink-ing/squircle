---
// Every way of decorating a pill, labelled, in whichever mode the URL asks
// for. Deliberately not built on the site layout: that registers the worklet,
// which can never be unregistered, and each mode has to choose for itself.
import "../../styles/global.css";

interface Example {
  /** The classes under test, shown as the label. */
  classes: string;
  /** What to expect. */
  note: string;
  /**
   * How the example is built: on the pill itself, or the way the README
   * recommends for what a pill's shape would otherwise erase.
   */
  build?: "pill" | "ring-wrapper" | "gap-wrapper" | "shadow-wrapper";
}

interface Section {
  title: string;
  intro: string;
  examples: Example[];
}

// Every class is spelled out in full so Tailwind finds and generates it.
const sections: Section[] = [
  {
    title: "Clip paths of its own",
    intro:
      "An element can have only one clip-path. The worklet shapes with a mask, so a clip just applies on top; the polyfill shapes with a clip, so it cuts the element's own clip to the pill outline and sets the two as one.",
    examples: [
      { classes: "[clip-path:inset(0_0_0_50%)]", note: "The right half of the pill." },
      {
        classes: "[clip-path:polygon(0_0,100%_0,0_100%)]",
        note: "The pill's top-left triangle.",
      },
      {
        classes: "[clip-path:circle(40%_at_100%_50%)]",
        note: "A lens: the pill inside a circle centred on its right edge.",
      },
      {
        classes: "[clip-path:inset(6px_round_10px)]",
        note: "The pill inside a rounded rectangle 6px in from each edge.",
      },
    ],
  },
  {
    title: "Tailwind mask utilities",
    intro:
      "Layered with the pill's own mask, so each one adds to the shape instead of replacing it.",
    examples: [
      { classes: "mask-b-from-20%", note: "Fades out towards the bottom." },
      { classes: "mask-r-from-40%", note: "Fades out towards the right." },
      { classes: "mask-radial-from-40%", note: "Fades out from the centre." },
    ],
  },
  {
    title: "Borders",
    intro:
      "Drawn by the pill along its own outline, from Tailwind's border utilities, with tailwind-pill-border loaded.",
    examples: [
      { classes: "border-2 border-white", note: "A solid ring along the outline." },
      { classes: "border-4 border-dashed border-amber-300", note: "Dashes along the outline." },
      { classes: "border-2 border-dotted border-white", note: "Dots along the outline." },
    ],
  },
  {
    title: "Outlines",
    intro:
      "An outline is drawn around the stadium border-radius. Inside the box the pill only trims it; outside the box the pill's shape erases it, so an outer outline goes on a wrapper.",
    examples: [
      {
        classes: "outline-2 outline-white",
        note: "Outside the box: erased by the pill's shape.",
      },
      {
        classes: "outline-2 outline-offset-4 outline-white",
        note: "Offset further out: erased too.",
      },
      {
        classes: "outline-2 -outline-offset-2 outline-white",
        note: "Inset just inside the edge: follows the stadium, trimmed to the pill.",
      },
      {
        classes: "outline-2 -outline-offset-6 outline-white",
        note: "Inset further: a stadium inside the pill.",
      },
      {
        classes: "squircle-pill bg-white p-0.5",
        note: "The outline on a padded pill wrapper instead.",
        build: "ring-wrapper",
      },
      {
        classes: "squircle-pill bg-white p-0.5 › squircle-pill bg-zinc-950 p-1",
        note: "An offset outline: a wrapper with a gap pill inside it.",
        build: "gap-wrapper",
      },
    ],
  },
  {
    title: "Tailwind ring utilities",
    intro:
      "Rings are box-shadows. Outer rings sit outside the box and are erased like an outline; inset rings stay inside it.",
    examples: [
      { classes: "ring-2 ring-white", note: "Outside the box: erased by the pill's shape." },
      {
        classes: "ring-2 ring-white ring-offset-2 ring-offset-zinc-950",
        note: "With an offset: erased too.",
      },
      {
        classes: "inset-ring-2 inset-ring-white",
        note: "Inside the box: follows the stadium, trimmed to the pill.",
      },
      {
        classes: "squircle-pill bg-white p-0.5",
        note: "The ring on a padded pill wrapper instead.",
        build: "ring-wrapper",
      },
    ],
  },
  {
    title: "Shadows",
    intro:
      "An outer shadow falls outside the box, and a filter runs before the pill's shape is applied, so both go on a wrapper. Inner shadows stay inside the box.",
    examples: [
      {
        classes: "shadow-lg shadow-indigo-500/50",
        note: "Outside the box: erased by the pill's shape.",
      },
      {
        classes: "drop-shadow-lg drop-shadow-indigo-500/50",
        note: "A filter on the pill: shaped away with it.",
      },
      { classes: "shadow-inner", note: "Inside the box: follows the stadium, trimmed to the pill." },
      {
        classes: "inset-shadow-sm inset-shadow-black/60",
        note: "Inside the box: follows the stadium, trimmed to the pill.",
      },
      {
        classes: "drop-shadow-lg drop-shadow-indigo-500/50",
        note: "The drop shadow on a plain wrapper: follows the pill's real shape.",
        build: "shadow-wrapper",
      },
    ],
  },
];

const modes = [
  ["auto", "Auto: worklet, or the polyfill"],
  ["worklet", "Worklet only"],
  ["polyfill", "Polyfill"],
  ["none", "No shaping"],
] as const;

const PILL = "squircle-pill h-12 w-40 bg-indigo-500";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pill gallery</title>
  </head>
  <body class="bg-zinc-950 px-4 py-8 text-zinc-100 sm:px-8">
    <main class="mx-auto max-w-6xl">
      <p class="mb-2 text-sm"><a href="/demos" class="text-indigo-400 hover:underline">← Demos</a></p>
      <h1 class="mb-2 text-3xl font-bold">Pill gallery</h1>
      <p class="mb-4 max-w-3xl text-sm text-zinc-400">
        Every pill below is <code class="text-zinc-300">{PILL}</code> plus the classes in its label.
        Switch modes to compare how each is drawn; each loads the page afresh. The notes describe a
        shaped pill: with no shaping each is a plain stadium, so what the shape would erase still
        shows.
      </p>
      <nav class="mb-2 flex flex-wrap gap-2 text-sm" aria-label="Drawing mode">
        {
          modes.map(([mode, label]) => (
            <a
              href={`?mode=${mode}`}
              data-mode={mode}
              class="rounded border border-zinc-700 px-3 py-1 hover:border-indigo-500"
            >
              {label}
            </a>
          ))
        }
      </nav>
      <p class="mb-10 text-sm text-zinc-400">
        Drawn by <span id="drawn-by" class="text-zinc-200">…</span>
      </p>

      {
        sections.map((section) => (
          <section class="mb-12">
            <h2 class="mb-1 text-xl font-semibold">{section.title}</h2>
            <p class="mb-5 max-w-3xl text-sm text-zinc-400">{section.intro}</p>
            <ul class="grid grid-cols-[repeat(auto-fill,minmax(14rem,1fr))] gap-x-6 gap-y-8">
              {section.examples.map(({ classes, note, build = "pill" }) => (
                <li class="flex flex-col items-start gap-3">
                  <div class="flex h-20 items-center px-3">
                    {build === "pill" && <div class={`${PILL} ${classes}`} />}
                    {build === "ring-wrapper" && (
                      <div class="squircle-pill bg-white p-0.5">
                        <div class={PILL} />
                      </div>
                    )}
                    {build === "gap-wrapper" && (
                      <div class="squircle-pill bg-white p-0.5">
                        <div class="squircle-pill bg-zinc-950 p-1">
                          <div class={PILL} />
                        </div>
                      </div>
                    )}
                    {build === "shadow-wrapper" && (
                      <div class={classes}>
                        <div class={PILL} />
                      </div>
                    )}
                  </div>
                  <div>
                    <p class="font-mono text-xs break-all text-zinc-200">
                      {build === "pill" ? classes : `wrapper: ${classes}`}
                    </p>
                    <p class="mt-1 text-xs text-zinc-400">{note}</p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </main>

    <script>
      import "../../lib/pill-gallery";
    </script>
  </body>
</html>
