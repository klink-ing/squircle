---
// Choose the renderer here rather than through Layout, which loads it itself.
import "../../styles/global.css";

const presets = [
  { name: "Small shadow", value: "0 1px 2px 0 rgb(0 0 0 / 0.1)" },
  { name: "Large blur", value: "0 10px 20px -4px rgb(0 0 0 / 0.35)" },
  { name: "Negative offset and spread", value: "-8px 5px 12px -2px rgb(0 0 0 / 0.5)" },
  { name: "Multiple shadows", value: "0 2px 4px rgb(0 0 0 / 0.2), -8px 10px 16px -3px rgb(0 0 0 / 0.35)" },
  { name: "Relative units", value: "0 0.25em 0.5rem -0.1em rgb(0 0 0 / 0.4)" },
  { name: "Inset only", value: "inset 0 2px 4px rgb(0 0 0 / 0.4)" },
  { name: "None", value: "none" },
];
const examples = [
  { name: "Small", classes: "shadow-sm", note: "Tailwind's shadow-sm." },
  { name: "Large", classes: "shadow-xl", note: "Tailwind's shadow-xl." },
  { name: "Negative offset", classes: "shadow-[-8px_5px_12px_-2px_rgb(0_0_0/0.5)]", note: "A literal shadow with negative offset and spread." },
  { name: "Hover and focus", classes: "shadow-sm group-hover:shadow-xl group-focus-within:shadow-xl", note: "Hover this row or focus either button to lift both." },
];
const button = "h-12 w-16 bg-teal-600 px-2 py-2 text-sm font-semibold text-white min-[360px]:w-24 sm:w-40 sm:px-4";
const modes = [["auto", "Auto"], ["worklet", "Worklet only"], ["polyfill", "Polyfill"], ["none", "Native fallback"]];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pill shadows — plain Tailwind comparison</title>
  </head>
  <body class="min-h-screen bg-zinc-950 px-4 py-8 text-zinc-100 sm:px-8">
    <main class="mx-auto max-w-5xl">
      <a href="/demos" class="text-sm text-teal-400 hover:underline">← Demos</a>
      <h1 class="mt-4 mb-3 text-3xl font-semibold tracking-tight sm:text-4xl">Compare pill shadows</h1>
      <p class="max-w-3xl text-sm leading-6 text-zinc-400">
        Same size, fill and shadow. The left button uses plain Tailwind with <code class="text-zinc-200">rounded-full</code>.
        The right uses <code class="text-zinc-200">squircle-pill</code>. The plain button has no squircle classes or attributes.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
        <nav class="flex flex-wrap gap-2 text-sm" aria-label="Drawing mode">
          {modes.map(([mode, label]) => <a href={`?mode=${mode}`} data-mode={mode} class="rounded-md border border-zinc-700 px-3 py-1.5 hover:border-teal-500">{label}</a>)}
        </nav>
        <p class="text-xs text-zinc-400">Squircle drawn by <span id="drawn-by" class="text-zinc-200">…</span></p>
      </div>

      <section class="mt-8" aria-labelledby="live-heading">
        <h2 id="live-heading" class="text-lg font-semibold">Try your shadow</h2>
        <div class="mt-3 grid gap-4 rounded-xl border border-zinc-800 bg-zinc-900 p-4 sm:grid-cols-[14rem_1fr]">
          <label class="flex flex-col gap-2 text-xs font-medium text-zinc-300">
            Preset
            <select id="shadow-preset" class="h-10 rounded-md border border-zinc-700 bg-zinc-950 px-3 text-sm text-zinc-100">
              {presets.map(({ name, value }) => <option value={value}>{name}</option>)}
              <option value="custom">Custom</option>
            </select>
          </label>
          <label class="flex flex-col gap-2 text-xs font-medium text-zinc-300">
            CSS box-shadow value
            <input id="shadow-value" value={presets[0]!.value} spellcheck="false" class="h-10 w-full rounded-md border border-zinc-700 bg-zinc-950 px-3 font-mono text-xs text-zinc-100" aria-describedby="shadow-message" />
          </label>
          <p id="shadow-message" class="text-xs text-zinc-400 sm:col-span-2" aria-live="polite">Both buttons use shadow-(--button-shadow). Edit the value to update both.</p>
        </div>
        <div id="shadow-comparison" style={`--button-shadow: ${presets[0]!.value}`} class="mt-4 rounded-xl bg-zinc-100 text-zinc-950">
          <div class="grid grid-cols-2 border-b border-zinc-200 text-center text-xs font-semibold">
            <p class="px-3 py-4">Plain Tailwind</p>
            <p class="border-l border-zinc-200 px-3 py-4">Squircle pill</p>
          </div>
          <div class="grid grid-cols-2">
            <div class="flex min-h-48 items-center justify-center px-3 py-16 sm:px-8">
              <button id="plain-shadow" type="button" class={`${button} rounded-full shadow-(--button-shadow)`}>Button</button>
            </div>
            <div class="flex min-h-48 items-center justify-center border-l border-zinc-200 px-3 py-16 sm:px-8">
              <button id="pill-shadow" type="button" class={`${button} squircle-pill shadow-(--button-shadow)`}>Button</button>
            </div>
          </div>
        </div>
        <details class="mt-3 text-xs text-zinc-400">
          <summary class="cursor-pointer hover:text-zinc-200">Show the classes</summary>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            <code class="rounded-md bg-zinc-900 p-3 break-all">{button} rounded-full shadow-(--button-shadow)</code>
            <code class="rounded-md bg-zinc-900 p-3 break-all">{button} squircle-pill shadow-(--button-shadow)</code>
          </div>
        </details>
      </section>

      <section class="mt-10 mb-12" aria-labelledby="utilities-heading">
        <h2 id="utilities-heading" class="mb-4 text-lg font-semibold">Compare utilities</h2>
        <div class="space-y-4">
          {examples.map(({ name, classes, note }) => (
            <article class="group rounded-xl bg-zinc-100 text-zinc-950">
              <div class="border-b border-zinc-200 px-5 py-3">
                <h3 class="text-sm font-semibold">{name}</h3>
                <p class="mt-1 text-xs text-zinc-600">{note}</p>
                <code class="mt-1 block text-xs break-all text-zinc-500">{classes}</code>
              </div>
              <div class="grid grid-cols-2">
                <div class="flex min-h-40 flex-col items-center justify-center gap-6 px-3 py-12">
                  <span class="text-xs text-zinc-500">Plain Tailwind</span>
                  <button type="button" class={`${button} rounded-full ${classes}`}>Button</button>
                </div>
                <div class="flex min-h-40 flex-col items-center justify-center gap-6 border-l border-zinc-200 px-3 py-12">
                  <span class="text-xs text-zinc-500">Squircle pill</span>
                  <button type="button" class={`${button} squircle-pill ${classes}`}>Button</button>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>
    <script>
      import "../../lib/pill-gallery";
      import "../../lib/pill-shadows-demo";
    </script>
  </body>
</html>
