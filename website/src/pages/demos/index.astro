---
import Layout from "../../components/Layout.astro";
---

<Layout title="Demos — @klinking/squircle">
  <h2 class="mb-6 text-2xl font-bold">Demos</h2>
  <p class="mb-8 text-zinc-400">
    Explore squircle utilities, compare pill shapes and shadows, and measure rendering
    performance. The framework sandboxes include live-editable code.
  </p>

  <ul class="grid gap-4 sm:grid-cols-2">
    <li>
      <a href="/demos/pill-shadows" class="block rounded-lg border border-zinc-800 p-6 transition hover:border-teal-500 hover:bg-zinc-900">
        <h3 class="text-lg font-semibold">Pill shadows</h3>
        <p class="mt-2 text-sm text-zinc-400">Compare plain Tailwind shadows with squircle pills side by side. Try CSS variables, multiple shadows, hover states and the polyfill.</p>
      </a>
    </li>
    <li>
      <a
        href="/demos/pill-gallery"
        class="block rounded-lg border border-zinc-800 p-6 transition hover:border-teal-500 hover:bg-zinc-900"
      >
        <h3 class="text-lg font-semibold">Pill gallery</h3>
        <p class="mt-2 text-sm text-zinc-400">
          Explore pill sides, backgrounds, borders, outlines, rings and shadows.
          Compare the worklet, polyfill and native fallback.
        </p>
      </a>
    </li>
    <li>
      <a
        href="/demos/pill-max-radius"
        class="block rounded-lg border border-zinc-800 p-6 transition hover:border-teal-500 hover:bg-zinc-900"
      >
        <h3 class="text-lg font-semibold">Pill max radius</h3>
        <p class="mt-2 text-sm text-zinc-400">
          Keep a growing composer's corners round: pills that stop getting rounder past a radius,
          in Tailwind, the polyfill and the fallback.
        </p>
      </a>
    </li>
    <li>
      <a
        href="/demos/pill-algorithms"
        class="block rounded-lg border border-zinc-800 p-6 transition hover:border-teal-500 hover:bg-zinc-900"
      >
        <h3 class="text-lg font-semibold">Pill algorithms</h3>
        <p class="mt-2 text-sm text-zinc-400">
          Compare the shipped pill shape with a CAD-style fillet, with interactive
          controls, curvature combs and plots.
        </p>
      </a>
    </li>
    <li>
      <a
        href="/demos/tailwind"
        class="block rounded-lg border border-zinc-800 p-6 transition hover:border-indigo-500 hover:bg-zinc-900"
      >
        <h3 class="text-lg font-semibold">Tailwind</h3>
        <p class="mt-2 text-sm text-zinc-400">
          Compare regular rounded corners with squircle corners at different
          radii using Tailwind CSS utilities.
        </p>
      </a>
    </li>
    <li>
      <a
        href="/demos/stylex"
        class="block rounded-lg border border-zinc-800 p-6 transition hover:border-indigo-500 hover:bg-zinc-900"
      >
        <h3 class="text-lg font-semibold">StyleX</h3>
        <p class="mt-2 text-sm text-zinc-400">
          Squircle utilities authored as StyleX dynamic styles —
          <code class="text-zinc-300">stylex.props(squircle.all('1rem'))</code>.
        </p>
      </a>
    </li>
    <li>
      <a
        href="/demos/panda"
        class="block rounded-lg border border-zinc-800 p-6 transition hover:border-indigo-500 hover:bg-zinc-900"
      >
        <h3 class="text-lg font-semibold">Panda CSS</h3>
        <p class="mt-2 text-sm text-zinc-400">
          Squircle utilities via the Panda preset, prefixed to coexist with
          Tailwind on the same page.
        </p>
      </a>
    </li>
  </ul>
  <h3 class="mt-10 mb-4 text-lg font-semibold">Benchmarks</h3>
  <a
    href="/bench/pills"
    class="mb-10 block rounded-lg border border-zinc-800 p-6 transition hover:border-indigo-500 hover:bg-zinc-900"
  >
    <h4 class="text-lg font-semibold">Pill resize benchmark</h4>
    <p class="mt-2 text-sm text-zinc-400">
      Measure rendering performance while resizing pills, comparing the worklet,
      polyfill and native fallback at different pill counts.
    </p>
  </a>
</Layout>
