{
  "name": "@klinking/squircle",
  "version": "0.0.0",
  "description": "Tailwind CSS v4 squircle (superellipse) corner utilities with visual radius correction",
  "keywords": [
    "border-radius",
    "corner-shape",
    "squircle",
    "superellipse",
    "tailwind-plugin",
    "tailwindcss"
  ],
  "homepage": "https://squircle.klink.ing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klink-ing/squircle.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./tailwind": {
      "types": "./dist/tailwind/index.d.mts",
      "import": "./dist/tailwind/index.mjs"
    },
    "./tailwind/utils.css": "./dist/tailwind/utils.css",
    "./tailwind-pill": {
      "types": "./dist/tailwind-pill/index.d.mts",
      "import": "./dist/tailwind-pill/index.mjs"
    },
    "./tailwind-pill-border": {
      "types": "./dist/tailwind-pill-border/index.d.mts",
      "import": "./dist/tailwind-pill-border/index.mjs"
    },
    "./radius-function.css": "./dist/radius-function.css",
    "./squircle-pill.css": "./dist/squircle-pill.css",
    "./pill-shape.worklet": {
      "types": "./dist/pill-shape.worklet.d.mts",
      "import": "./dist/pill-shape.worklet.mjs"
    },
    "./pill-shape.worklet.js": "./dist/pill-shape.worklet.mjs",
    "./panda": {
      "types": "./dist/panda/index.d.mts",
      "import": "./dist/panda/index.mjs"
    },
    "./stylex": {
      "types": "./dist/stylex/index.d.mts",
      "import": "./dist/stylex/index.mjs"
    }
  },
  "scripts": {
    "dev": "vp run pill-dev",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.28.0",
    "@pandacss/dev": "^1.11.0",
    "@stylexjs/babel-plugin": "^0.18.3",
    "@stylexjs/stylex": "^0.18.3",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.2",
    "oxlint": "^1.58.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.1.15",
    "vite-plus": "catalog:",
    "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.15"
  },
  "peerDependencies": {
    "@pandacss/dev": ">=0.40.0",
    "@stylexjs/stylex": ">=0.18.0",
    "tailwind-merge": ">=2.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@pandacss/dev": {
      "optional": true
    },
    "@stylexjs/stylex": {
      "optional": true
    },
    "tailwind-merge": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.33.0",
  "squircle": {
    "cssNamespace": "klinking"
  }
}
