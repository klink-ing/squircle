{
  "name": "@klinking/squircle",
  "version": "0.1.0",
  "description": "Tailwind CSS v4 squircle (superellipse) corner utilities with visual radius correction",
  "keywords": [
    "border-radius",
    "corner-shape",
    "squircle",
    "superellipse",
    "tailwind-plugin",
    "tailwindcss"
  ],
  "homepage": "https://dogmar.github.io/squircle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dogmar/squircle.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./tailwind": {
      "types": "./dist/tailwind/index.d.mts",
      "import": "./dist/tailwind/index.mjs"
    },
    "./tailwind/utils.css": "./dist/tailwind/utils.css",
    "./tailwind/radius.css": "./dist/tailwind/radius.css",
    "./panda": {
      "types": "./dist/panda/index.d.mts",
      "import": "./dist/panda/index.mjs"
    },
    "./stylex": {
      "types": "./dist/stylex/index.d.mts",
      "import": "./dist/stylex/index.mjs"
    }
  },
  "scripts": {
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.28.0",
    "@pandacss/dev": "^1.11.0",
    "@stylexjs/babel-plugin": "^0.18.3",
    "@stylexjs/stylex": "^0.18.3",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.2",
    "oxlint": "^1.58.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.1.15",
    "vite-plus": "catalog:",
    "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.15"
  },
  "peerDependencies": {
    "@pandacss/dev": ">=0.40.0",
    "@stylexjs/stylex": ">=0.18.0",
    "tailwind-merge": ">=2.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@pandacss/dev": {
      "optional": true
    },
    "@stylexjs/stylex": {
      "optional": true
    },
    "tailwind-merge": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.33.0"
}
